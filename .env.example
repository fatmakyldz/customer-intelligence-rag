# ── Backend ────────────────────────────────────────────────
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Optional. Default: openai/gpt-oss-120b (free tier). Alternatives: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=

# Local docker:  postgresql://postgres:postgres@localhost:5432/ragdb
# Neon/Supabase: copy the connection string; keep ?sslmode=require (TLS is enabled automatically)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb

# Required on a public deployment: protects POST /api/ingest. Leave empty locally.
ADMIN_TOKEN=
# Comma-separated frontend origins allowed to call the API. Empty = allow all (local only).
CORS_ORIGINS=
# Questions per minute per visitor (default 5)
QUERY_RATE_LIMIT_PER_MIN=
# Seed the demo documents when the knowledge base is empty (default true)
SEED_ON_EMPTY=

# ── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
