# MOD-DC Local Intelligence Platform — environment
# Local LLM via Ollama (no cloud, fully offline)
# Default model: qwen2.5  |  Fallbacks: llama3.1, mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# When the backend runs inside Docker and Ollama runs on the host machine,
# use host.docker.internal instead of localhost:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb
NEXT_PUBLIC_API_URL=http://localhost:3001
